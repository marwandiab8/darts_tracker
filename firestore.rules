rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Where each dart landed: an optional map of target to three slots, each {x, y} or null, so
    // at most 21 entries. The app writes it only for darts placed by tapping the board.
    function validPositions(data) {
      return !data.keys().hasAny(['positions'])
        || (data.positions is map && data.positions.size() <= 21);
    }

    // A session exactly as the app's Save button writes it. Anyone with a Google account can
    // sign in, so new sessions are checked for shape and range: a session scores at most
    // 3 darts on each of 21 targets, so 200 is a safe ceiling.
    function validNewSession(data) {
      return data.keys().hasOnly(['uid', 'timestamp', 'mode', 'entry', 'total', 'positions', 'durationSec'])
        && optionalNumber(data, 'durationSec', 0, 86400)
        && data.keys().hasAll(['uid', 'timestamp', 'mode', 'entry', 'total'])
        && validPositions(data)
        && data.uid == request.auth.uid
        && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 20
        && data.mode in ['standard', 'single']
        && data.total is int && data.total >= 0 && data.total <= 200
        && data.entry is map && data.entry.size() <= 21;
    }

    // Older sessions carry other fields (imports, a missing mode), so an update only has to
    // stay sane and keep the same owner.
    function validSessionUpdate(data) {
      return data.uid == request.auth.uid
        && data.keys().size() <= 20
        && data.total is number && data.total >= 0 && data.total <= 200
        && data.entry is map && data.entry.size() <= 21
        && validPositions(data);
    }

    // The live draft is written on every tap, and older drafts carry legacy fields, so it
    // is checked for owner and size rather than an exact list of fields.
    function validDraft(data) {
      return data.uid == request.auth.uid
        && data.keys().size() <= 20
        && data.entry is map && data.entry.size() <= 21
        && validPositions(data);
    }

    // A version of a live game or session (see match /liveGames below): the game itself is JSON text.
    function validLiveGame(data) {
      return data.keys().hasOnly(['uid', 'vid', 'parent', 'by', 'at', 'phase', 'rev', 'state'])
        && data.keys().hasAll(['uid', 'vid', 'parent', 'by', 'at', 'phase', 'rev', 'state'])
        && data.uid == request.auth.uid
        && data.vid is string && data.vid.size() >= 8 && data.vid.size() <= 40
        && data.parent is string && data.parent.size() <= 40
        && data.by is string && data.by.size() >= 1 && data.by.size() <= 40
        && data.at is number
        && data.phase in ['play', 'over', 'none']
        && data.rev is int && data.rev >= 1
        && data.state is string && data.state.size() <= 900000;
    }

    // A dart in a note on the cameras' reading (see match /notes): what it scored and where (app position).
    function validNoteDart(p) {
      return p == null || (p is map && p.keys().hasOnly(['label', 'x', 'y']) && p.label is string && p.label.size() <= 8
        && (p.x == null || p.x is number) && (p.y == null || p.y is number));
    }
    function validNote(data, id) {
      return data.keys().hasOnly(['seq', 'at', 'page', 'outcome', 'read', 'truth', 'pictures'])
        && data.keys().hasAll(['seq', 'at', 'page', 'outcome'])
        && data.seq is int && string(data.seq) == id
        && data.at is int
        && data.page in ['practice', 'tracker']
        && data.outcome in ['kept', 'corrected']
        && validNoteDart(data.get('read', null)) && validNoteDart(data.get('truth', null))
        && (!data.keys().hasAny(['pictures']) || data.pictures is bool);
    }

    function optionalNumber(data, key, low, high) {
      return !data.keys().hasAny([key]) || (data[key] is number && data[key] >= low && data[key] <= high);
    }

    // A finished (or abandoned) practice game against the bot, exactly as practice.html saves it.
    // Every dart is stored as {x, y, s}: where it landed and what it scored, at most 600 a side.
    // A game is never edited after it is saved, so there is no update rule below.
    function validBotGame(data) {
      return data.keys().hasOnly(['uid', 'timestamp', 'kind', 'startScore', 'doubleOut', 'rank', 'first', 'result',
          'durationSec', 'rounds', 'playerAvg', 'botAvg', 'playerScore', 'botScore', 'playerDarts', 'botDarts'])
        && data.keys().hasAll(['uid', 'timestamp', 'kind', 'rank', 'result', 'playerDarts', 'botDarts'])
        && data.uid == request.auth.uid
        && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 20
        && data.kind in ['x01', 'cricket']
        && (data.kind == 'x01'
            ? (data.keys().hasAll(['startScore', 'doubleOut'])
                && data.startScore is int && data.startScore >= 201 && data.startScore <= 701
                && data.startScore % 100 == 1 && data.doubleOut is bool)
            : !data.keys().hasAny(['startScore', 'doubleOut']))
        && data.rank in ['beginner', 'casual', 'club', 'league', 'pro']
        && (!data.keys().hasAny(['first']) || data.first in ['player', 'bot'])
        && data.result in ['won', 'lost', 'abandoned']
        && data.playerDarts is list && data.playerDarts.size() <= 600
        && data.botDarts is list && data.botDarts.size() <= 600
        && optionalNumber(data, 'durationSec', 0, 86400)
        && optionalNumber(data, 'rounds', 0, 1000)
        && optionalNumber(data, 'playerAvg', 0, 300)
        && optionalNumber(data, 'botAvg', 0, 300)
        && optionalNumber(data, 'playerScore', 0, 100000)
        && optionalNumber(data, 'botScore', 0, 100000);
    }

    function validEmail(value) {
      return value is string && value.size() >= 5 && value.size() <= 254
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // A finished (or abandoned) game between two people sharing the phone, as practice.html saves it.
    // The first player is the signed-in user, so their email must be the one on their account. Once
    // saved, a Cloud Function emails the result to both players; it writes the email status itself,
    // so a game is never edited by the app after it is saved.
    function validVersusGame(data) {
      return data.keys().hasOnly(['uid', 'timestamp', 'kind', 'startScore', 'doubleOut', 'first', 'result',
          'durationSec', 'rounds', 'playerName', 'playerEmail', 'opponentName', 'opponentEmail',
          'playerAvg', 'opponentAvg', 'playerScore', 'opponentScore', 'playerDarts', 'opponentDarts', 'log'])
        && data.keys().hasAll(['uid', 'timestamp', 'kind', 'result', 'playerName', 'playerEmail', 'opponentName',
          'opponentEmail', 'playerDarts', 'opponentDarts'])
        && data.uid == request.auth.uid
        && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 20
        && data.kind in ['x01', 'cricket']
        && (data.kind == 'x01'
            ? (data.keys().hasAll(['startScore', 'doubleOut'])
                && data.startScore is int && data.startScore >= 201 && data.startScore <= 701
                && data.startScore % 100 == 1 && data.doubleOut is bool)
            : !data.keys().hasAny(['startScore', 'doubleOut']))
        && (!data.keys().hasAny(['first']) || data.first in ['player', 'bot'])
        && data.result in ['won', 'lost', 'abandoned']
        && data.playerName is string && data.playerName.size() <= 60
        && data.opponentName is string && data.opponentName.size() <= 60
        && validEmail(data.playerEmail) && data.playerEmail == request.auth.token.email
        && validEmail(data.opponentEmail)
        && data.playerDarts is list && data.playerDarts.size() <= 600
        && data.opponentDarts is list && data.opponentDarts.size() <= 600
        && (!data.keys().hasAny(['log']) || (data.log is list && data.log.size() <= 400))
        && optionalNumber(data, 'durationSec', 0, 86400)
        && optionalNumber(data, 'rounds', 0, 1000)
        && optionalNumber(data, 'playerAvg', 0, 300)
        && optionalNumber(data, 'opponentAvg', 0, 300)
        && optionalNumber(data, 'playerScore', 0, 100000)
        && optionalNumber(data, 'opponentScore', 0, 100000);
    }

    // A finished JDC Challenge round, exactly as challenge.html saves it (public/challenge-engine.js
    // `record`): 57 darts, each 0 miss, 1 single, 2 double or 3 treble, and the scores worked out from
    // them. Never edited after it is saved.
    function validChallengeGame(data) {
      return data.keys().hasOnly(['uid', 'timestamp', 'total', 'part1', 'part2', 'part3', 'trebles', 'shanghais',
          'doublesHit', 'darts', 'durationSec'])
        && data.keys().hasAll(['uid', 'timestamp', 'total', 'part1', 'part2', 'part3', 'darts'])
        && data.uid == request.auth.uid
        && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 20
        && data.darts is list && data.darts.size() == 57
        && data.total is int && data.total >= 0 && data.total <= 3330
        && data.part1 is int && data.part1 >= 0 && data.part1 <= 1050
        && data.part2 is int && data.part2 >= 0 && data.part2 <= 1050
        && data.part3 is int && data.part3 >= 0 && data.part3 <= 1230
        && data.total == data.part1 + data.part2 + data.part3
        && optionalNumber(data, 'trebles', 0, 36)
        && optionalNumber(data, 'shanghais', 0, 12)
        && optionalNumber(data, 'doublesHit', 0, 21)
        && optionalNumber(data, 'durationSec', 0, 86400);
    }

    // The camera station (station.html and public/board-camera.js): the computer the cameras are
    // plugged into reads the darts and passes them, with pictures of the board and its state, to its
    // owner's other computers, which keep the cameras' calibration here. Only the owner reads or
    // writes any of it.
    function validStation(data, uid) {
      return data.keys().hasOnly(['uid', 'setup', 'station', 'ask'])
        && data.uid == uid
        && (!data.keys().hasAny(['setup']) || (data.setup is map
            && (!data.setup.keys().hasAny(['cameras']) || (data.setup.cameras is list && data.setup.cameras.size() <= 2))))
        && (!data.keys().hasAny(['station']) || data.station is map)
        && (!data.keys().hasAny(['ask']) || data.ask is map);
    }

    match /cameraStations/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validStation(request.resource.data, uid);

      // Each camera's latest picture, as a JPEG data URL (a document holds at most 1 MiB).
      match /stills/{camera} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && camera in ['0', '1']
          && request.resource.data.keys().hasOnly(['jpeg', 'width', 'height', 'label', 'taken', 'for'])
          && request.resource.data.jpeg is string && request.resource.data.jpeg.size() <= 900000;
      }

      // What happened to each dart the cameras put into a game, once its visit was over: kept (read
      // right) or corrected to where it really landed (public/board-learn.js). The station adds
      // whether it kept that dart's pictures to learn from.
      match /notes/{seq} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && validNote(request.resource.data, seq);
      }

      // The station's last 20 events (darts, take-outs...), each with a rising number.
      match /events/{name} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && name == 'latest'
          && request.resource.data.keys().hasOnly(['seq', 'events', 'updated'])
          && request.resource.data.events is list && request.resource.data.events.size() <= 20;
      }
    }

    // Live typing sync per user.
    match /liveDrafts/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validDraft(request.resource.data);
    }

    // The game being played against the bot or a friend (practice.html, public/live-sync.js), the
    // same on all the owner's devices: one document, a new version of it with each change. A
    // version must be made from the latest one (its parent), so when two devices change the game
    // at the same moment only the first gets in, and the other takes that one; a new game
    // (parent '') replaces whatever is there.
    match /liveGames/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validLiveGame(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid && validLiveGame(request.resource.data)
        && (request.resource.data.parent == resource.data.vid || request.resource.data.parent == '');
    }

    // The tracker's session being entered (index.html), shared the same way: it replaces the
    // older liveDrafts document, which a page opened before this change still writes.
    match /liveSessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validLiveGame(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid && validLiveGame(request.resource.data)
        && (request.resource.data.parent == resource.data.vid || request.resource.data.parent == '');
    }

    // The Doubles game (doubles.html, doubles-engine.js): one state document per player with the
    // round in progress, the lifetime totals and the last thing Undo can take back.
    match /doublesState/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'activeSession', 'lifetime', 'lastUndo', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.lifetime is map
        && (!('activeSession' in request.resource.data) || request.resource.data.activeSession == null || request.resource.data.activeSession is map)
        && (!('lastUndo' in request.resource.data) || request.resource.data.lastUndo == null || request.resource.data.lastUndo is map);
    }

    // Finished Doubles rounds, one per session key. Sessions carried over from the old My Doubles
    // Progress app keep the fields its versions wrote, and are marked importedFrom.
    function validDoublesSession(data) {
      return data.keys().hasOnly(['uid', 'startedAtMs', 'localDate', 'endedAtMs', 'activeMs', 'totalDarts', 'extraDarts',
          'perDouble', 'createdAt', 'importedFrom', 'rounds', 'startedAt', 'durationMs', 'dartsUsed', 'endedAt',
          'lastTarget', 'savedAt', 'totalDartsPlanned'])
        && data.uid == request.auth.uid
        && data.startedAtMs is number
        && (!('perDouble' in data) || data.perDouble is map)
        && (!('perDouble' in data) || data.perDouble.size() <= 21);
    }

    match /doublesSessions/{sessionId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validDoublesSession(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && validDoublesSession(request.resource.data);
    }

    // Saved sessions history.
    match /sessions/{sessionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validNewSession(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && validSessionUpdate(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Practice games against the bot. Read and delete your own; a saved game is never edited.
    match /botGames/{gameId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validBotGame(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // JDC Challenge rounds (challenge.html). Read and delete your own; a saved round is never edited.
    match /challengeGames/{gameId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validChallengeGame(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Games between two people on one phone. Read and delete your own; never edited by the app.
    match /versusGames/{gameId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validVersusGame(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
