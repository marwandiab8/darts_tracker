{
  "name": "darts-tracker",
  "private": true,
  "scripts": {
    "test": "npm run check && npm run test:engine && npm run test:functions && npm run test:rules",
    "check": "npm run check:app && npm --prefix functions run check",
    "check:app": "node scripts/check-app.cjs",
    "test:engine": "node --test tests/practice-engine.test.cjs",
    "test:functions": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-darts \"node --test tests/firestore.rules.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0"
  }
}
